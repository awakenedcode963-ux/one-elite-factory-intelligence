rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules for the QMS system
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /iqc_inspections/{document=**} {
      allow read: if request.auth != null;
      // In production, restrict write to specific roles (e.g. QC Inspectors)
      allow write: if request.auth != null;
    }

    match /ipqc_logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /fqc_reports/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /calibration_logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
